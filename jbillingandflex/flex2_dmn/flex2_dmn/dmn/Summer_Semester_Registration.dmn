<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_SummerRegistration" name="Summer Semester Registration" namespace="http://flex2.nu.edu.pk/dmn/Definitions_SummerRegistration" exporter="FLEX2 DMN drafting toolkit (Claude)" exporterVersion="1.0"><decision id="Decision_SummerSemesterRegistration" name="Summer Semester Registration"><decisionTable id="Decision_SummerSemesterRegistration_Table" hitPolicy="FIRST"><input id="Decision_SummerSemesterRegistration_Input_1" label="Course Type"><inputExpression id="Decision_SummerSemesterRegistration_InputExpr_1" typeRef="string"><text>courseTypeId</text></inputExpression><inputValues id="Decision_SummerSemesterRegistration_InputVals_1"><text>"RESEARCH","REGULAR","..."</text></inputValues></input><input id="Decision_SummerSemesterRegistration_Input_2" label="Prior Registration Count (this student, this course)"><inputExpression id="Decision_SummerSemesterRegistration_InputExpr_2" typeRef="number"><text>priorRegistrationCount</text></inputExpression></input><input id="Decision_SummerSemesterRegistration_Input_3" label="Is Elective Taught By Unavailable-Otherwise Visiting Scholar"><inputExpression id="Decision_SummerSemesterRegistration_InputExpr_3" typeRef="boolean"><text>isElectiveTaughtByVisitingScholarUnavailableOtherwise</text></inputExpression></input><input id="Decision_SummerSemesterRegistration_Input_4" label="Is Needed To Graduate This Summer"><inputExpression id="Decision_SummerSemesterRegistration_InputExpr_4" typeRef="boolean"><text>isNeededToGraduateThisSummer</text></inputExpression></input><input id="Decision_SummerSemesterRegistration_Input_5" label="Repeat Course Count Requested"><inputExpression id="Decision_SummerSemesterRegistration_InputExpr_5" typeRef="number"><text>repeatCourseCountRequested</text></inputExpression></input><input id="Decision_SummerSemesterRegistration_Input_6" label="Enrolled Student Count"><inputExpression id="Decision_SummerSemesterRegistration_InputExpr_6" typeRef="number"><text>enrolledStudentCount</text></inputExpression></input><output id="Decision_SummerSemesterRegistration_Output_1" label="Registration Allowed" name="registrationAllowed" typeRef="boolean" /><output id="Decision_SummerSemesterRegistration_Output_2" label="Reason" name="reason" typeRef="string" /><rule id="Decision_SummerSemesterRegistration_Rule_1"><description>Rule 6.3 -- exposed as a real category test against COURSE.COURSE_TYPE_ID, replacing isResearchCourseOrProject (redesigned 2026-09-10)</description><inputEntry id="Decision_SummerSemesterRegistration_Rule_1_InEntry_1"><text>"RESEARCH"</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_1_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_1_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_1_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_1_InEntry_6"><text>-</text></inputEntry><outputEntry id="Decision_SummerSemesterRegistration_Rule_1_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_SummerSemesterRegistration_Rule_1_OutEntry_2"><text>"Research courses/projects are not offered in summer"</text></outputEntry></rule><rule id="Decision_SummerSemesterRegistration_Rule_2"><description>Rule 6.4 -- exposed as a real count (priorRegistrationCount = 0, i.e. no prior COURSE_REGISTRATION row), replacing isNewCourseRequest</description><inputEntry id="Decision_SummerSemesterRegistration_Rule_2_InEntry_1"><text>not("RESEARCH")</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_2_InEntry_2"><text>0</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_2_InEntry_3"><text>false</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_2_InEntry_4"><text>false</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_2_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_2_InEntry_6"><text>-</text></inputEntry><outputEntry id="Decision_SummerSemesterRegistration_Rule_2_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_SummerSemesterRegistration_Rule_2_OutEntry_2"><text>"New (non-exempt) course registration is not allowed in summer"</text></outputEntry></rule><rule id="Decision_SummerSemesterRegistration_Rule_3"><description>Rule 6.6</description><inputEntry id="Decision_SummerSemesterRegistration_Rule_3_InEntry_1"><text>not("RESEARCH")</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_3_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_3_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_3_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_3_InEntry_5"><text>&gt; 2</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_3_InEntry_6"><text>-</text></inputEntry><outputEntry id="Decision_SummerSemesterRegistration_Rule_3_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_SummerSemesterRegistration_Rule_3_OutEntry_2"><text>"Maximum of 2 repeat courses (with associated labs) allowed in summer"</text></outputEntry></rule><rule id="Decision_SummerSemesterRegistration_Rule_4"><description>Rule 6.10 -- exposed as a real count (COUNT(COURSE_REGISTRATION) for the offering), replacing minimumTenStudentsEnrolled</description><inputEntry id="Decision_SummerSemesterRegistration_Rule_4_InEntry_1"><text>not("RESEARCH")</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_4_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_4_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_4_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_4_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_4_InEntry_6"><text>&lt; 10</text></inputEntry><outputEntry id="Decision_SummerSemesterRegistration_Rule_4_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_SummerSemesterRegistration_Rule_4_OutEntry_2"><text>"Course requires a minimum of 10 registered students to run"</text></outputEntry></rule><rule id="Decision_SummerSemesterRegistration_Rule_5"><inputEntry id="Decision_SummerSemesterRegistration_Rule_5_InEntry_1"><text>not("RESEARCH")</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_5_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_5_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_5_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_5_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_SummerSemesterRegistration_Rule_5_InEntry_6"><text>-</text></inputEntry><outputEntry id="Decision_SummerSemesterRegistration_Rule_5_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_SummerSemesterRegistration_Rule_5_OutEntry_2"><text>"Eligible for summer registration"</text></outputEntry></rule></decisionTable></decision><dmndi:DMNDI><dmndi:DMNDiagram id="Definitions_SummerRegistration_Diagram"><dmndi:DMNShape id="Decision_SummerSemesterRegistration_Shape" dmnElementRef="Decision_SummerSemesterRegistration"><dc:Bounds x="60" y="60" width="220" height="90" /></dmndi:DMNShape></dmndi:DMNDiagram></dmndi:DMNDI></definitions>
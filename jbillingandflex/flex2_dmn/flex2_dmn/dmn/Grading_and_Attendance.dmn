<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_GradingAndAttendance" name="Grading and Attendance" namespace="http://flex2.nu.edu.pk/dmn/Definitions_GradingAndAttendance" exporter="FLEX2 DMN drafting toolkit (Claude)" exporterVersion="1.0"><decision id="Decision_AttendancePercentage" name="Attendance Percentage"><variable id="Decision_AttendancePercentage_Var" name="attendancePercentage" typeRef="number" /><literalExpression id="Decision_AttendancePercentage_Expr"><text>(lecturesAttended / lecturesHeldForOffering) * 100</text></literalExpression></decision><decision id="Decision_AttendanceEligibility" name="Attendance Eligibility For Final Exam"><informationRequirement id="InfoReq_1"><requiredDecision href="#Decision_AttendancePercentage" /></informationRequirement><decisionTable id="Decision_AttendanceEligibility_Table" hitPolicy="UNIQUE"><input id="Decision_AttendanceEligibility_Input_1" label="Attendance Percentage"><inputExpression id="Decision_AttendanceEligibility_InputExpr_1" typeRef="number"><text>attendancePercentage</text></inputExpression></input><output id="Decision_AttendanceEligibility_Output_1" label="Eligible For Final Exam (Not Debarred)" name="eligibleForFinalExam" typeRef="boolean" /><output id="Decision_AttendanceEligibility_Output_2" label="Assigned Grade Override" name="assignedGradeOverride" typeRef="string" /><rule id="Decision_AttendanceEligibility_Rule_1"><description>Rule 1.21: attendance &gt;= 80% - eligible, not debarred</description><inputEntry id="Decision_AttendanceEligibility_Rule_1_InEntry_1"><text>&gt;= 80</text></inputEntry><outputEntry id="Decision_AttendanceEligibility_Rule_1_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_AttendanceEligibility_Rule_1_OutEntry_2"><text>null</text></outputEntry></rule><rule id="Decision_AttendanceEligibility_Rule_2"><description>Rule 1.22: attendance &lt; 80% - debarred from final exam, FA grade</description><inputEntry id="Decision_AttendanceEligibility_Rule_2_InEntry_1"><text>&lt; 80</text></inputEntry><outputEntry id="Decision_AttendanceEligibility_Rule_2_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_AttendanceEligibility_Rule_2_OutEntry_2"><text>"FA"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_GradePointsAndInterpretation" name="Grade Points and Interpretation"><decisionTable id="Decision_GradePointsAndInterpretation_Table" hitPolicy="UNIQUE"><input id="Decision_GradePointsAndInterpretation_Input_1" label="Letter Grade"><inputExpression id="Decision_GradePointsAndInterpretation_InputExpr_1" typeRef="string"><text>letterGrade</text></inputExpression><inputValues id="Decision_GradePointsAndInterpretation_InputVals_1"><text>"A+","A","A-","B+","B","B-","C+","C","C-","D+","D","F","FA","I","W"</text></inputValues></input><output id="Decision_GradePointsAndInterpretation_Output_1" label="Grade Points" name="gradePoints" typeRef="number" /><output id="Decision_GradePointsAndInterpretation_Output_2" label="Interpretation" name="interpretation" typeRef="string" /><rule id="Decision_GradePointsAndInterpretation_Rule_1"><description>Rules 2.2, 2.3</description><inputEntry id="Decision_GradePointsAndInterpretation_Rule_1_InEntry_1"><text>"A+"</text></inputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_1_OutEntry_1"><text>4.00</text></outputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_1_OutEntry_2"><text>"Outstanding"</text></outputEntry></rule><rule id="Decision_GradePointsAndInterpretation_Rule_2"><description>Rules 2.2, 2.3</description><inputEntry id="Decision_GradePointsAndInterpretation_Rule_2_InEntry_1"><text>"A"</text></inputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_2_OutEntry_1"><text>4.00</text></outputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_2_OutEntry_2"><text>"Excellent"</text></outputEntry></rule><rule id="Decision_GradePointsAndInterpretation_Rule_3"><description>Rules 2.2, 2.3</description><inputEntry id="Decision_GradePointsAndInterpretation_Rule_3_InEntry_1"><text>"A-"</text></inputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_3_OutEntry_1"><text>3.67</text></outputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_3_OutEntry_2"><text>"Excellent"</text></outputEntry></rule><rule id="Decision_GradePointsAndInterpretation_Rule_4"><description>Rules 2.2, 2.3</description><inputEntry id="Decision_GradePointsAndInterpretation_Rule_4_InEntry_1"><text>"B+"</text></inputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_4_OutEntry_1"><text>3.33</text></outputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_4_OutEntry_2"><text>"Good"</text></outputEntry></rule><rule id="Decision_GradePointsAndInterpretation_Rule_5"><description>Rules 2.2, 2.3</description><inputEntry id="Decision_GradePointsAndInterpretation_Rule_5_InEntry_1"><text>"B"</text></inputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_5_OutEntry_1"><text>3.00</text></outputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_5_OutEntry_2"><text>"Good"</text></outputEntry></rule><rule id="Decision_GradePointsAndInterpretation_Rule_6"><description>Rules 2.2, 2.3</description><inputEntry id="Decision_GradePointsAndInterpretation_Rule_6_InEntry_1"><text>"B-"</text></inputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_6_OutEntry_1"><text>2.67</text></outputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_6_OutEntry_2"><text>"Good"</text></outputEntry></rule><rule id="Decision_GradePointsAndInterpretation_Rule_7"><description>Rules 2.2, 2.3</description><inputEntry id="Decision_GradePointsAndInterpretation_Rule_7_InEntry_1"><text>"C+"</text></inputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_7_OutEntry_1"><text>2.33</text></outputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_7_OutEntry_2"><text>"Adequate"</text></outputEntry></rule><rule id="Decision_GradePointsAndInterpretation_Rule_8"><description>Rules 2.2, 2.3</description><inputEntry id="Decision_GradePointsAndInterpretation_Rule_8_InEntry_1"><text>"C"</text></inputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_8_OutEntry_1"><text>2.00</text></outputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_8_OutEntry_2"><text>"Adequate"</text></outputEntry></rule><rule id="Decision_GradePointsAndInterpretation_Rule_9"><description>Rules 2.2, 2.3</description><inputEntry id="Decision_GradePointsAndInterpretation_Rule_9_InEntry_1"><text>"C-"</text></inputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_9_OutEntry_1"><text>1.67</text></outputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_9_OutEntry_2"><text>"Pass, the student may repeat the course"</text></outputEntry></rule><rule id="Decision_GradePointsAndInterpretation_Rule_10"><description>Rules 2.2, 2.3</description><inputEntry id="Decision_GradePointsAndInterpretation_Rule_10_InEntry_1"><text>"D+"</text></inputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_10_OutEntry_1"><text>1.33</text></outputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_10_OutEntry_2"><text>"Pass, the student may repeat the course"</text></outputEntry></rule><rule id="Decision_GradePointsAndInterpretation_Rule_11"><description>Rules 2.2, 2.3</description><inputEntry id="Decision_GradePointsAndInterpretation_Rule_11_InEntry_1"><text>"D"</text></inputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_11_OutEntry_1"><text>1.00</text></outputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_11_OutEntry_2"><text>"Pass, the student may repeat the course"</text></outputEntry></rule><rule id="Decision_GradePointsAndInterpretation_Rule_12"><description>Rules 2.2, 2.3</description><inputEntry id="Decision_GradePointsAndInterpretation_Rule_12_InEntry_1"><text>"F"</text></inputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_12_OutEntry_1"><text>0.00</text></outputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_12_OutEntry_2"><text>"Fail"</text></outputEntry></rule><rule id="Decision_GradePointsAndInterpretation_Rule_13"><description>Rules 2.2, 2.3</description><inputEntry id="Decision_GradePointsAndInterpretation_Rule_13_InEntry_1"><text>"FA"</text></inputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_13_OutEntry_1"><text>0.00</text></outputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_13_OutEntry_2"><text>"Fail due to shortage of attendance"</text></outputEntry></rule><rule id="Decision_GradePointsAndInterpretation_Rule_14"><description>Rules 2.2, 2.9</description><inputEntry id="Decision_GradePointsAndInterpretation_Rule_14_InEntry_1"><text>"I"</text></inputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_14_OutEntry_1"><text>null</text></outputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_14_OutEntry_2"><text>"Incomplete"</text></outputEntry></rule><rule id="Decision_GradePointsAndInterpretation_Rule_15"><description>Rules 2.2, 2.8</description><inputEntry id="Decision_GradePointsAndInterpretation_Rule_15_InEntry_1"><text>"W"</text></inputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_15_OutEntry_1"><text>null</text></outputEntry><outputEntry id="Decision_GradePointsAndInterpretation_Rule_15_OutEntry_2"><text>"Withdrawn"</text></outputEntry></rule></decisionTable></decision><dmndi:DMNDI><dmndi:DMNDiagram id="Definitions_GradingAndAttendance_Diagram"><dmndi:DMNShape id="Decision_AttendancePercentage_Shape" dmnElementRef="Decision_AttendancePercentage"><dc:Bounds x="60" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_AttendanceEligibility_Shape" dmnElementRef="Decision_AttendanceEligibility"><dc:Bounds x="370" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_GradePointsAndInterpretation_Shape" dmnElementRef="Decision_GradePointsAndInterpretation"><dc:Bounds x="60" y="260" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNEdge id="Edge_1" dmnElementRef="InfoReq_1"><di:waypoint x="280" y="105" /><di:waypoint x="370" y="105" /></dmndi:DMNEdge></dmndi:DMNDiagram></dmndi:DMNDI></definitions>
<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_CreditTransferExemption" name="Credit Transfer Exemption" namespace="http://flex2.nu.edu.pk/dmn/Definitions_CreditTransferExemption" exporter="FLEX2 DMN drafting toolkit (Claude)" exporterVersion="1.0"><decision id="Decision_CreditTransferExemption" name="Credit Transfer Exemption"><decisionTable id="Decision_CreditTransferExemption_Table" hitPolicy="FIRST"><input id="Decision_CreditTransferExemption_Input_1" label="Cumulative Exempted Credit Percent If Granted"><inputExpression id="Decision_CreditTransferExemption_InputExpr_1" typeRef="number"><text>cumulativeExemptedCreditPercentIfGranted</text></inputExpression></input><input id="Decision_CreditTransferExemption_Input_2" label="Unmet Prerequisite-Also-Passed Count"><inputExpression id="Decision_CreditTransferExemption_InputExpr_2" typeRef="number"><text>unmetPrerequisiteAlsoPassedCount</text></inputExpression></input><output id="Decision_CreditTransferExemption_Output_1" label="Exemption Granted" name="exemptionGranted" typeRef="boolean" /><output id="Decision_CreditTransferExemption_Output_2" label="Credit Given For Prerequisite" name="creditGivenForPrerequisite" typeRef="boolean" /><output id="Decision_CreditTransferExemption_Output_3" label="Counts Toward CGPA" name="countsTowardCGPA" typeRef="boolean" /><output id="Decision_CreditTransferExemption_Output_4" label="Reason" name="reason" typeRef="string" /><rule id="Decision_CreditTransferExemption_Rule_1"><description>Rule 3.7</description><inputEntry id="Decision_CreditTransferExemption_Rule_1_InEntry_1"><text>&gt; 50</text></inputEntry><inputEntry id="Decision_CreditTransferExemption_Rule_1_InEntry_2"><text>-</text></inputEntry><outputEntry id="Decision_CreditTransferExemption_Rule_1_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_CreditTransferExemption_Rule_1_OutEntry_2"><text>false</text></outputEntry><outputEntry id="Decision_CreditTransferExemption_Rule_1_OutEntry_3"><text>false</text></outputEntry><outputEntry id="Decision_CreditTransferExemption_Rule_1_OutEntry_4"><text>"Would exceed the 50% cap on exempted credit hours of the degree program"</text></outputEntry></rule><rule id="Decision_CreditTransferExemption_Rule_2"><description>Rules 3.11, 3.12 -- exposed as a count over COURSE_PREREQ join COURSE_REGISTRATION, replacing prerequisiteCourseAlsoPassed (redesigned 2026-09-10)</description><inputEntry id="Decision_CreditTransferExemption_Rule_2_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_CreditTransferExemption_Rule_2_InEntry_2"><text>0</text></inputEntry><outputEntry id="Decision_CreditTransferExemption_Rule_2_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_CreditTransferExemption_Rule_2_OutEntry_2"><text>true</text></outputEntry><outputEntry id="Decision_CreditTransferExemption_Rule_2_OutEntry_3"><text>false</text></outputEntry><outputEntry id="Decision_CreditTransferExemption_Rule_2_OutEntry_4"><text>"Exemption granted; credit also given for the passed pre-requisite course"</text></outputEntry></rule><rule id="Decision_CreditTransferExemption_Rule_3"><description>Rule 3.12</description><inputEntry id="Decision_CreditTransferExemption_Rule_3_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_CreditTransferExemption_Rule_3_InEntry_2"><text>&gt; 0</text></inputEntry><outputEntry id="Decision_CreditTransferExemption_Rule_3_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_CreditTransferExemption_Rule_3_OutEntry_2"><text>false</text></outputEntry><outputEntry id="Decision_CreditTransferExemption_Rule_3_OutEntry_3"><text>false</text></outputEntry><outputEntry id="Decision_CreditTransferExemption_Rule_3_OutEntry_4"><text>"Exemption granted; only credit hours transfer, CGPA from previous institution does not"</text></outputEntry></rule></decisionTable></decision><dmndi:DMNDI><dmndi:DMNDiagram id="Definitions_CreditTransferExemption_Diagram"><dmndi:DMNShape id="Decision_CreditTransferExemption_Shape" dmnElementRef="Decision_CreditTransferExemption"><dc:Bounds x="60" y="60" width="220" height="90" /></dmndi:DMNShape></dmndi:DMNDiagram></dmndi:DMNDI></definitions>
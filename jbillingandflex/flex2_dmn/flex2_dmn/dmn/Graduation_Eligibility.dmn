<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_GraduationEligibility" name="Graduation Eligibility" namespace="http://flex2.nu.edu.pk/dmn/Definitions_GraduationEligibility" exporter="FLEX2 DMN drafting toolkit (Claude)" exporterVersion="1.0"><decision id="Decision_GraduationEligibility" name="Graduation Eligibility"><decisionTable id="Decision_GraduationEligibility_Table" hitPolicy="FIRST"><input id="Decision_GraduationEligibility_Input_1" label="Credit Hours Earned"><inputExpression id="Decision_GraduationEligibility_InputExpr_1" typeRef="number"><text>creditHoursEarned</text></inputExpression></input><input id="Decision_GraduationEligibility_Input_2" label="Degree Minimum Credit Hours"><inputExpression id="Decision_GraduationEligibility_InputExpr_2" typeRef="number"><text>degreeMinimumCreditHours</text></inputExpression></input><input id="Decision_GraduationEligibility_Input_3" label="Cumulative GPA"><inputExpression id="Decision_GraduationEligibility_InputExpr_3" typeRef="number"><text>cumulativeGPA</text></inputExpression></input><input id="Decision_GraduationEligibility_Input_4" label="Semesters Elapsed"><inputExpression id="Decision_GraduationEligibility_InputExpr_4" typeRef="number"><text>semestersElapsed</text></inputExpression></input><input id="Decision_GraduationEligibility_Input_5" label="Years Elapsed"><inputExpression id="Decision_GraduationEligibility_InputExpr_5" typeRef="number"><text>yearsElapsed</text></inputExpression></input><output id="Decision_GraduationEligibility_Output_1" label="Eligible To Graduate" name="eligibleToGraduate" typeRef="boolean" /><output id="Decision_GraduationEligibility_Output_2" label="Reason" name="reason" typeRef="string" /><rule id="Decision_GraduationEligibility_Rule_1"><description>Rule 1.25</description><inputEntry id="Decision_GraduationEligibility_Rule_1_InEntry_1"><text>&lt; degreeMinimumCreditHours</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_1_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_1_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_1_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_GraduationEligibility_Rule_1_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_GraduationEligibility_Rule_1_OutEntry_2"><text>"Credit hours earned below the program's required minimum"</text></outputEntry></rule><rule id="Decision_GraduationEligibility_Rule_2"><description>Rule 1.26</description><inputEntry id="Decision_GraduationEligibility_Rule_2_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_2_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_2_InEntry_3"><text>&lt; 2.00</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_2_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_2_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_GraduationEligibility_Rule_2_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_GraduationEligibility_Rule_2_OutEntry_2"><text>"CGPA below the minimum 2.00 required for graduation"</text></outputEntry></rule><rule id="Decision_GraduationEligibility_Rule_3"><description>Rule 1.23</description><inputEntry id="Decision_GraduationEligibility_Rule_3_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_3_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_3_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_3_InEntry_4"><text>&lt; 8</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_3_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_GraduationEligibility_Rule_3_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_GraduationEligibility_Rule_3_OutEntry_2"><text>"Cannot graduate before completing the minimum duration of 4 years / 8 regular semesters"</text></outputEntry></rule><rule id="Decision_GraduationEligibility_Rule_4"><description>Rule 1.23</description><inputEntry id="Decision_GraduationEligibility_Rule_4_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_4_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_4_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_4_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_4_InEntry_5"><text>&gt; 7</text></inputEntry><outputEntry id="Decision_GraduationEligibility_Rule_4_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_GraduationEligibility_Rule_4_OutEntry_2"><text>"Exceeded the maximum allowed duration of 7 years"</text></outputEntry></rule><rule id="Decision_GraduationEligibility_Rule_5"><inputEntry id="Decision_GraduationEligibility_Rule_5_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_5_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_5_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_5_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_GraduationEligibility_Rule_5_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_GraduationEligibility_Rule_5_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_GraduationEligibility_Rule_5_OutEntry_2"><text>"Meets minimum credit-hour, CGPA, and duration requirements for graduation"</text></outputEntry></rule></decisionTable></decision><dmndi:DMNDI><dmndi:DMNDiagram id="Definitions_GraduationEligibility_Diagram"><dmndi:DMNShape id="Decision_GraduationEligibility_Shape" dmnElementRef="Decision_GraduationEligibility"><dc:Bounds x="60" y="60" width="220" height="90" /></dmndi:DMNShape></dmndi:DMNDiagram></dmndi:DMNDI></definitions>
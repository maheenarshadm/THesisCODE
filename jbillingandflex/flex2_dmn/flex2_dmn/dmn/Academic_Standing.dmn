<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_AcademicStanding" name="Academic Standing" namespace="http://flex2.nu.edu.pk/dmn/Definitions_AcademicStanding" exporter="FLEX2 DMN drafting toolkit (Claude)" exporterVersion="1.0"><decision id="Decision_AcademicWarningStatus" name="Academic Warning Status"><decisionTable id="Decision_AcademicWarningStatus_Table" hitPolicy="UNIQUE"><input id="Decision_AcademicWarningStatus_Input_1" label="Cumulative GPA"><inputExpression id="Decision_AcademicWarningStatus_InputExpr_1" typeRef="number"><text>cumulativeGPA</text></inputExpression></input><input id="Decision_AcademicWarningStatus_Input_2" label="Prior Warning Count"><inputExpression id="Decision_AcademicWarningStatus_InputExpr_2" typeRef="number"><text>priorWarningCount</text></inputExpression></input><output id="Decision_AcademicWarningStatus_Output_1" label="New Warning Count" name="newWarningCount" typeRef="number" /><output id="Decision_AcademicWarningStatus_Output_2" label="Admission Status" name="admissionStatus" typeRef="string" /><output id="Decision_AcademicWarningStatus_Output_3" label="Warning Action" name="warningAction" typeRef="string" /><rule id="Decision_AcademicWarningStatus_Rule_1"><description>Rule 5.4</description><inputEntry id="Decision_AcademicWarningStatus_Rule_1_InEntry_1"><text>&gt;= 2.00</text></inputEntry><inputEntry id="Decision_AcademicWarningStatus_Rule_1_InEntry_2"><text>0</text></inputEntry><outputEntry id="Decision_AcademicWarningStatus_Rule_1_OutEntry_1"><text>0</text></outputEntry><outputEntry id="Decision_AcademicWarningStatus_Rule_1_OutEntry_2"><text>"Active"</text></outputEntry><outputEntry id="Decision_AcademicWarningStatus_Rule_1_OutEntry_3"><text>"None"</text></outputEntry></rule><rule id="Decision_AcademicWarningStatus_Rule_2"><description>Rule 5.7</description><inputEntry id="Decision_AcademicWarningStatus_Rule_2_InEntry_1"><text>&gt;= 2.00</text></inputEntry><inputEntry id="Decision_AcademicWarningStatus_Rule_2_InEntry_2"><text>1</text></inputEntry><outputEntry id="Decision_AcademicWarningStatus_Rule_2_OutEntry_1"><text>0</text></outputEntry><outputEntry id="Decision_AcademicWarningStatus_Rule_2_OutEntry_2"><text>"Active"</text></outputEntry><outputEntry id="Decision_AcademicWarningStatus_Rule_2_OutEntry_3"><text>"Warning cleared"</text></outputEntry></rule><rule id="Decision_AcademicWarningStatus_Rule_3"><description>Rule 5.7</description><inputEntry id="Decision_AcademicWarningStatus_Rule_3_InEntry_1"><text>&gt;= 2.00</text></inputEntry><inputEntry id="Decision_AcademicWarningStatus_Rule_3_InEntry_2"><text>2</text></inputEntry><outputEntry id="Decision_AcademicWarningStatus_Rule_3_OutEntry_1"><text>0</text></outputEntry><outputEntry id="Decision_AcademicWarningStatus_Rule_3_OutEntry_2"><text>"Active"</text></outputEntry><outputEntry id="Decision_AcademicWarningStatus_Rule_3_OutEntry_3"><text>"Warning cleared"</text></outputEntry></rule><rule id="Decision_AcademicWarningStatus_Rule_4"><description>Rule 5.5</description><inputEntry id="Decision_AcademicWarningStatus_Rule_4_InEntry_1"><text>&lt; 2.00</text></inputEntry><inputEntry id="Decision_AcademicWarningStatus_Rule_4_InEntry_2"><text>0</text></inputEntry><outputEntry id="Decision_AcademicWarningStatus_Rule_4_OutEntry_1"><text>1</text></outputEntry><outputEntry id="Decision_AcademicWarningStatus_Rule_4_OutEntry_2"><text>"Active"</text></outputEntry><outputEntry id="Decision_AcademicWarningStatus_Rule_4_OutEntry_3"><text>"Issue 1st academic warning"</text></outputEntry></rule><rule id="Decision_AcademicWarningStatus_Rule_5"><description>Rules 5.5, 4.4d</description><inputEntry id="Decision_AcademicWarningStatus_Rule_5_InEntry_1"><text>&lt; 2.00</text></inputEntry><inputEntry id="Decision_AcademicWarningStatus_Rule_5_InEntry_2"><text>1</text></inputEntry><outputEntry id="Decision_AcademicWarningStatus_Rule_5_OutEntry_1"><text>2</text></outputEntry><outputEntry id="Decision_AcademicWarningStatus_Rule_5_OutEntry_2"><text>"Active"</text></outputEntry><outputEntry id="Decision_AcademicWarningStatus_Rule_5_OutEntry_3"><text>"Issue 2nd academic warning; parents/guardian called to campus"</text></outputEntry></rule><rule id="Decision_AcademicWarningStatus_Rule_6"><description>Rules 5.6, 3.24</description><inputEntry id="Decision_AcademicWarningStatus_Rule_6_InEntry_1"><text>&lt; 2.00</text></inputEntry><inputEntry id="Decision_AcademicWarningStatus_Rule_6_InEntry_2"><text>2</text></inputEntry><outputEntry id="Decision_AcademicWarningStatus_Rule_6_OutEntry_1"><text>3</text></outputEntry><outputEntry id="Decision_AcademicWarningStatus_Rule_6_OutEntry_2"><text>"Closed"</text></outputEntry><outputEntry id="Decision_AcademicWarningStatus_Rule_6_OutEntry_3"><text>"3rd consecutive low-CGPA semester: admission automatically closed"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_CourseLoadLimit" name="Course Load Limit"><informationRequirement id="InfoReq_1"><requiredDecision href="#Decision_AcademicWarningStatus" /></informationRequirement><decisionTable id="Decision_CourseLoadLimit_Table" hitPolicy="UNIQUE"><input id="Decision_CourseLoadLimit_Input_1" label="Semester Type"><inputExpression id="Decision_CourseLoadLimit_InputExpr_1" typeRef="string"><text>semesterType</text></inputExpression><inputValues id="Decision_CourseLoadLimit_InputVals_1"><text>"Regular","Summer"</text></inputValues></input><input id="Decision_CourseLoadLimit_Input_2" label="New Warning Count"><inputExpression id="Decision_CourseLoadLimit_InputExpr_2" typeRef="number"><text>newWarningCount</text></inputExpression></input><output id="Decision_CourseLoadLimit_Output_1" label="Max Courses Allowed" name="maxCoursesAllowed" typeRef="number" /><output id="Decision_CourseLoadLimit_Output_2" label="Course Load Basis" name="courseLoadBasis" typeRef="string" /><rule id="Decision_CourseLoadLimit_Rule_1"><description>Rule 1.17</description><inputEntry id="Decision_CourseLoadLimit_Rule_1_InEntry_1"><text>"Regular"</text></inputEntry><inputEntry id="Decision_CourseLoadLimit_Rule_1_InEntry_2"><text>0</text></inputEntry><outputEntry id="Decision_CourseLoadLimit_Rule_1_OutEntry_1"><text>99</text></outputEntry><outputEntry id="Decision_CourseLoadLimit_Rule_1_OutEntry_2"><text>"Per approved study plan (rule 1.17) - not capped by this rule"</text></outputEntry></rule><rule id="Decision_CourseLoadLimit_Rule_2"><description>Rule 4.4c</description><inputEntry id="Decision_CourseLoadLimit_Rule_2_InEntry_1"><text>"Regular"</text></inputEntry><inputEntry id="Decision_CourseLoadLimit_Rule_2_InEntry_2"><text>1</text></inputEntry><outputEntry id="Decision_CourseLoadLimit_Rule_2_OutEntry_1"><text>5</text></outputEntry><outputEntry id="Decision_CourseLoadLimit_Rule_2_OutEntry_2"><text>"Capped at 5 due to 1st academic warning"</text></outputEntry></rule><rule id="Decision_CourseLoadLimit_Rule_3"><description>Rule 4.4c/4.4e</description><inputEntry id="Decision_CourseLoadLimit_Rule_3_InEntry_1"><text>"Regular"</text></inputEntry><inputEntry id="Decision_CourseLoadLimit_Rule_3_InEntry_2"><text>2</text></inputEntry><outputEntry id="Decision_CourseLoadLimit_Rule_3_OutEntry_1"><text>5</text></outputEntry><outputEntry id="Decision_CourseLoadLimit_Rule_3_OutEntry_2"><text>"Capped at 5 due to 2nd academic warning; new-course registration additionally restricted"</text></outputEntry></rule><rule id="Decision_CourseLoadLimit_Rule_4"><description>Rule 6.6</description><inputEntry id="Decision_CourseLoadLimit_Rule_4_InEntry_1"><text>"Summer"</text></inputEntry><inputEntry id="Decision_CourseLoadLimit_Rule_4_InEntry_2"><text>-</text></inputEntry><outputEntry id="Decision_CourseLoadLimit_Rule_4_OutEntry_1"><text>2</text></outputEntry><outputEntry id="Decision_CourseLoadLimit_Rule_4_OutEntry_2"><text>"Summer semester cap of 2 courses"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_AdmissionClosureEligibility" name="Admission Closure Eligibility"><informationRequirement id="InfoReq_2"><requiredDecision href="#Decision_AcademicWarningStatus" /></informationRequirement><decisionTable id="Decision_AdmissionClosureEligibility_Table" hitPolicy="FIRST"><input id="Decision_AdmissionClosureEligibility_Input_1" label="New Warning Count"><inputExpression id="Decision_AdmissionClosureEligibility_InputExpr_1" typeRef="number"><text>newWarningCount</text></inputExpression></input><input id="Decision_AdmissionClosureEligibility_Input_2" label="Years Since Program Start"><inputExpression id="Decision_AdmissionClosureEligibility_InputExpr_2" typeRef="number"><text>yearsSinceProgramStart</text></inputExpression></input><input id="Decision_AdmissionClosureEligibility_Input_3" label="Registration Status"><inputExpression id="Decision_AdmissionClosureEligibility_InputExpr_3" typeRef="string"><text>regStatus</text></inputExpression><inputValues id="Decision_AdmissionClosureEligibility_InputVals_3"><text>"ACTIVE","SUSPENDED_NOT_RESTORED","..."</text></inputValues></input><input id="Decision_AdmissionClosureEligibility_Input_4" label="New-Admission Eligibility Not Met"><inputExpression id="Decision_AdmissionClosureEligibility_InputExpr_4" typeRef="boolean"><text>newAdmissionEligibilityNotMet</text></inputExpression></input><output id="Decision_AdmissionClosureEligibility_Output_1" label="Admission Status" name="admissionStatus" typeRef="string" /><output id="Decision_AdmissionClosureEligibility_Output_2" label="Closure Reason" name="closureReason" typeRef="string" /><rule id="Decision_AdmissionClosureEligibility_Rule_1"><description>Rules 3.24, 5.6</description><inputEntry id="Decision_AdmissionClosureEligibility_Rule_1_InEntry_1"><text>3</text></inputEntry><inputEntry id="Decision_AdmissionClosureEligibility_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_AdmissionClosureEligibility_Rule_1_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_AdmissionClosureEligibility_Rule_1_InEntry_4"><text>-</text></inputEntry><outputEntry id="Decision_AdmissionClosureEligibility_Rule_1_OutEntry_1"><text>"Closed"</text></outputEntry><outputEntry id="Decision_AdmissionClosureEligibility_Rule_1_OutEntry_2"><text>"3rd consecutive academic warning (CGPA&lt;2.00 for 3 consecutive semesters)"</text></outputEntry></rule><rule id="Decision_AdmissionClosureEligibility_Rule_2"><description>Rule 3.25 -- exposed as a real date-derived duration compared against the 7-year cap, replacing maxDurationExceeded (redesigned 2026-09-10)</description><inputEntry id="Decision_AdmissionClosureEligibility_Rule_2_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_AdmissionClosureEligibility_Rule_2_InEntry_2"><text>&gt; 7</text></inputEntry><inputEntry id="Decision_AdmissionClosureEligibility_Rule_2_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_AdmissionClosureEligibility_Rule_2_InEntry_4"><text>-</text></inputEntry><outputEntry id="Decision_AdmissionClosureEligibility_Rule_2_OutEntry_1"><text>"Closed"</text></outputEntry><outputEntry id="Decision_AdmissionClosureEligibility_Rule_2_OutEntry_2"><text>"Maximum duration to complete degree exceeded"</text></outputEntry></rule><rule id="Decision_AdmissionClosureEligibility_Rule_3"><description>Rule 3.26 -- exposed as a real status-code test against STUDENT_PROGRAM.REG_STATUS (via D_STUDENT_REG_STATUS), replacing suspendedRegistrationNotRestored; the specific code value is unconfirmed since Flex1.sql ships no seed/reference data, same caveat already documented for this schema's other coded values</description><inputEntry id="Decision_AdmissionClosureEligibility_Rule_3_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_AdmissionClosureEligibility_Rule_3_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_AdmissionClosureEligibility_Rule_3_InEntry_3"><text>"SUSPENDED_NOT_RESTORED"</text></inputEntry><inputEntry id="Decision_AdmissionClosureEligibility_Rule_3_InEntry_4"><text>-</text></inputEntry><outputEntry id="Decision_AdmissionClosureEligibility_Rule_3_OutEntry_1"><text>"Closed"</text></outputEntry><outputEntry id="Decision_AdmissionClosureEligibility_Rule_3_OutEntry_2"><text>"Failure to restore suspended registration"</text></outputEntry></rule><rule id="Decision_AdmissionClosureEligibility_Rule_4"><description>Rule 3.28</description><inputEntry id="Decision_AdmissionClosureEligibility_Rule_4_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_AdmissionClosureEligibility_Rule_4_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_AdmissionClosureEligibility_Rule_4_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_AdmissionClosureEligibility_Rule_4_InEntry_4"><text>true</text></inputEntry><outputEntry id="Decision_AdmissionClosureEligibility_Rule_4_OutEntry_1"><text>"Closed"</text></outputEntry><outputEntry id="Decision_AdmissionClosureEligibility_Rule_4_OutEntry_2"><text>"Awaited result did not meet eligibility criteria for the degree program"</text></outputEntry></rule><rule id="Decision_AdmissionClosureEligibility_Rule_5"><inputEntry id="Decision_AdmissionClosureEligibility_Rule_5_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_AdmissionClosureEligibility_Rule_5_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_AdmissionClosureEligibility_Rule_5_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_AdmissionClosureEligibility_Rule_5_InEntry_4"><text>-</text></inputEntry><outputEntry id="Decision_AdmissionClosureEligibility_Rule_5_OutEntry_1"><text>"Open"</text></outputEntry><outputEntry id="Decision_AdmissionClosureEligibility_Rule_5_OutEntry_2"><text>"No closure condition met"</text></outputEntry></rule></decisionTable></decision><decision id="Decision_CourseRegistrationEligibility" name="Course Registration Eligibility"><informationRequirement id="InfoReq_3"><requiredDecision href="#Decision_AcademicWarningStatus" /></informationRequirement><informationRequirement id="InfoReq_4"><requiredDecision href="#Decision_CourseLoadLimit" /></informationRequirement><decisionTable id="Decision_CourseRegistrationEligibility_Table" hitPolicy="FIRST"><input id="Decision_CourseRegistrationEligibility_Input_1" label="Unmet Prerequisite Count"><inputExpression id="Decision_CourseRegistrationEligibility_InputExpr_1" typeRef="number"><text>unmetPrerequisiteCount</text></inputExpression></input><input id="Decision_CourseRegistrationEligibility_Input_2" label="New Warning Count"><inputExpression id="Decision_CourseRegistrationEligibility_InputExpr_2" typeRef="number"><text>newWarningCount</text></inputExpression></input><input id="Decision_CourseRegistrationEligibility_Input_3" label="Previous Grade In This Course"><inputExpression id="Decision_CourseRegistrationEligibility_InputExpr_3" typeRef="string"><text>previousGradeInCourse</text></inputExpression><inputValues id="Decision_CourseRegistrationEligibility_InputVals_3"><text>"F","D","D+","C-","C","..."</text></inputValues></input><input id="Decision_CourseRegistrationEligibility_Input_4" label="Projected Total Courses This Registration"><inputExpression id="Decision_CourseRegistrationEligibility_InputExpr_4" typeRef="number"><text>projectedTotalCoursesThisRegistration</text></inputExpression></input><input id="Decision_CourseRegistrationEligibility_Input_5" label="Max Courses Allowed"><inputExpression id="Decision_CourseRegistrationEligibility_InputExpr_5" typeRef="number"><text>maxCoursesAllowed</text></inputExpression></input><output id="Decision_CourseRegistrationEligibility_Output_1" label="Can Register Course" name="canRegisterCourse" typeRef="boolean" /><output id="Decision_CourseRegistrationEligibility_Output_2" label="Reason" name="reason" typeRef="string" /><rule id="Decision_CourseRegistrationEligibility_Rule_1"><description>Rule 1.20 -- exposed as a count over COURSE_PREREQ join COURSE_REGISTRATION.GRADE, replacing allPrerequisitesPassed (redesigned 2026-09-10)</description><inputEntry id="Decision_CourseRegistrationEligibility_Rule_1_InEntry_1"><text>&gt; 0</text></inputEntry><inputEntry id="Decision_CourseRegistrationEligibility_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_CourseRegistrationEligibility_Rule_1_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_CourseRegistrationEligibility_Rule_1_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_CourseRegistrationEligibility_Rule_1_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_CourseRegistrationEligibility_Rule_1_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_CourseRegistrationEligibility_Rule_1_OutEntry_2"><text>"Pre-requisite course(s) not passed"</text></outputEntry></rule><rule id="Decision_CourseRegistrationEligibility_Rule_2"><description>Rule 4.4e -- exposed as a real FEEL list-membership test against the previous grade, replacing isMandatoryReregistration</description><inputEntry id="Decision_CourseRegistrationEligibility_Rule_2_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_CourseRegistrationEligibility_Rule_2_InEntry_2"><text>2</text></inputEntry><inputEntry id="Decision_CourseRegistrationEligibility_Rule_2_InEntry_3"><text>not("F","D","D+","C-")</text></inputEntry><inputEntry id="Decision_CourseRegistrationEligibility_Rule_2_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_CourseRegistrationEligibility_Rule_2_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_CourseRegistrationEligibility_Rule_2_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_CourseRegistrationEligibility_Rule_2_OutEntry_2"><text>"On 2nd academic warning: may not register for a new (non-mandatory) course without HoD recommendation + Controller approval"</text></outputEntry></rule><rule id="Decision_CourseRegistrationEligibility_Rule_3"><description>Rules 1.19, 4.3, 4.4c</description><inputEntry id="Decision_CourseRegistrationEligibility_Rule_3_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_CourseRegistrationEligibility_Rule_3_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_CourseRegistrationEligibility_Rule_3_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_CourseRegistrationEligibility_Rule_3_InEntry_4"><text>&gt; maxCoursesAllowed</text></inputEntry><inputEntry id="Decision_CourseRegistrationEligibility_Rule_3_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_CourseRegistrationEligibility_Rule_3_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_CourseRegistrationEligibility_Rule_3_OutEntry_2"><text>"Exceeds maximum permitted course load"</text></outputEntry></rule><rule id="Decision_CourseRegistrationEligibility_Rule_4"><inputEntry id="Decision_CourseRegistrationEligibility_Rule_4_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_CourseRegistrationEligibility_Rule_4_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_CourseRegistrationEligibility_Rule_4_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_CourseRegistrationEligibility_Rule_4_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_CourseRegistrationEligibility_Rule_4_InEntry_5"><text>-</text></inputEntry><outputEntry id="Decision_CourseRegistrationEligibility_Rule_4_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_CourseRegistrationEligibility_Rule_4_OutEntry_2"><text>"Eligible"</text></outputEntry></rule></decisionTable></decision><dmndi:DMNDI><dmndi:DMNDiagram id="Definitions_AcademicStanding_Diagram"><dmndi:DMNShape id="Decision_AcademicWarningStatus_Shape" dmnElementRef="Decision_AcademicWarningStatus"><dc:Bounds x="60" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_CourseLoadLimit_Shape" dmnElementRef="Decision_CourseLoadLimit"><dc:Bounds x="370" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_AdmissionClosureEligibility_Shape" dmnElementRef="Decision_AdmissionClosureEligibility"><dc:Bounds x="370" y="260" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNShape id="Decision_CourseRegistrationEligibility_Shape" dmnElementRef="Decision_CourseRegistrationEligibility"><dc:Bounds x="680" y="60" width="220" height="90" /></dmndi:DMNShape><dmndi:DMNEdge id="Edge_1" dmnElementRef="InfoReq_1"><di:waypoint x="280" y="105" /><di:waypoint x="370" y="105" /></dmndi:DMNEdge><dmndi:DMNEdge id="Edge_2" dmnElementRef="InfoReq_2"><di:waypoint x="280" y="105" /><di:waypoint x="370" y="305" /></dmndi:DMNEdge><dmndi:DMNEdge id="Edge_3" dmnElementRef="InfoReq_3"><di:waypoint x="280" y="105" /><di:waypoint x="680" y="105" /></dmndi:DMNEdge><dmndi:DMNEdge id="Edge_4" dmnElementRef="InfoReq_4"><di:waypoint x="590" y="105" /><di:waypoint x="680" y="105" /></dmndi:DMNEdge></dmndi:DMNDiagram></dmndi:DMNDI></definitions>
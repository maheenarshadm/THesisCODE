<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_CourseReplacement" name="Course Replacement Eligibility" namespace="http://flex2.nu.edu.pk/dmn/Definitions_CourseReplacement" exporter="FLEX2 DMN drafting toolkit (Claude)" exporterVersion="1.0"><decision id="Decision_CourseReplacementEligibility" name="Course Replacement Eligibility"><decisionTable id="Decision_CourseReplacementEligibility_Table" hitPolicy="FIRST"><input id="Decision_CourseReplacementEligibility_Input_1" label="Credits Earned"><inputExpression id="Decision_CourseReplacementEligibility_InputExpr_1" typeRef="number"><text>creditsEarned</text></inputExpression></input><input id="Decision_CourseReplacementEligibility_Input_2" label="Degree Total Credits"><inputExpression id="Decision_CourseReplacementEligibility_InputExpr_2" typeRef="number"><text>degreeTotalCredits</text></inputExpression></input><input id="Decision_CourseReplacementEligibility_Input_3" label="Grade In Course To Replace"><inputExpression id="Decision_CourseReplacementEligibility_InputExpr_3" typeRef="string"><text>gradeInCourseToReplace</text></inputExpression></input><input id="Decision_CourseReplacementEligibility_Input_4" label="Course Offered In Following Semesters"><inputExpression id="Decision_CourseReplacementEligibility_InputExpr_4" typeRef="boolean"><text>courseOfferedInFollowingSemesters</text></inputExpression></input><input id="Decision_CourseReplacementEligibility_Input_5" label="Replacing Course Passed At Least One Semester After"><inputExpression id="Decision_CourseReplacementEligibility_InputExpr_5" typeRef="boolean"><text>replacingCoursePassedAtLeastOneSemesterAfter</text></inputExpression></input><input id="Decision_CourseReplacementEligibility_Input_6" label="Course Type"><inputExpression id="Decision_CourseReplacementEligibility_InputExpr_6" typeRef="string"><text>courseTypeId</text></inputExpression><inputValues id="Decision_CourseReplacementEligibility_InputVals_6"><text>"CORE","ELECTIVE","..."</text></inputValues></input><output id="Decision_CourseReplacementEligibility_Output_1" label="Eligible For Replacement" name="eligibleForReplacement" typeRef="boolean" /><output id="Decision_CourseReplacementEligibility_Output_2" label="Reason" name="reason" typeRef="string" /><rule id="Decision_CourseReplacementEligibility_Rule_1"><description>Rule 4.28 -- exposed as a real category test against COURSE.COURSE_TYPE_ID (via D_COURSE_TYPE), replacing isCoreCourse (redesigned 2026-09-10)</description><inputEntry id="Decision_CourseReplacementEligibility_Rule_1_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_1_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_1_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_1_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_1_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_1_InEntry_6"><text>"CORE"</text></inputEntry><outputEntry id="Decision_CourseReplacementEligibility_Rule_1_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_CourseReplacementEligibility_Rule_1_OutEntry_2"><text>"Core courses cannot be replaced"</text></outputEntry></rule><rule id="Decision_CourseReplacementEligibility_Rule_2"><description>Rule 4.27(b)</description><inputEntry id="Decision_CourseReplacementEligibility_Rule_2_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_2_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_2_InEntry_3"><text>not("F")</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_2_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_2_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_2_InEntry_6"><text>-</text></inputEntry><outputEntry id="Decision_CourseReplacementEligibility_Rule_2_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_CourseReplacementEligibility_Rule_2_OutEntry_2"><text>"Only a course with grade F may be replaced"</text></outputEntry></rule><rule id="Decision_CourseReplacementEligibility_Rule_3"><description>Rule 4.27(a) -- exposed as a real cross-variable comparison (creditsEarned &lt; degreeTotalCredits), replacing degreeRequirementsCompletedOrCompletingThisSemester</description><inputEntry id="Decision_CourseReplacementEligibility_Rule_3_InEntry_1"><text>&lt; degreeTotalCredits</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_3_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_3_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_3_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_3_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_3_InEntry_6"><text>-</text></inputEntry><outputEntry id="Decision_CourseReplacementEligibility_Rule_3_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_CourseReplacementEligibility_Rule_3_OutEntry_2"><text>"Student has not completed / is not completing degree requirements this semester"</text></outputEntry></rule><rule id="Decision_CourseReplacementEligibility_Rule_4"><description>Rule 4.27(c)</description><inputEntry id="Decision_CourseReplacementEligibility_Rule_4_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_4_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_4_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_4_InEntry_4"><text>true</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_4_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_4_InEntry_6"><text>-</text></inputEntry><outputEntry id="Decision_CourseReplacementEligibility_Rule_4_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_CourseReplacementEligibility_Rule_4_OutEntry_2"><text>"Course to be replaced was offered again in a following semester"</text></outputEntry></rule><rule id="Decision_CourseReplacementEligibility_Rule_5"><description>Rule 4.27(d)</description><inputEntry id="Decision_CourseReplacementEligibility_Rule_5_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_5_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_5_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_5_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_5_InEntry_5"><text>false</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_5_InEntry_6"><text>-</text></inputEntry><outputEntry id="Decision_CourseReplacementEligibility_Rule_5_OutEntry_1"><text>false</text></outputEntry><outputEntry id="Decision_CourseReplacementEligibility_Rule_5_OutEntry_2"><text>"Replacing course must be passed at least one semester after the course being replaced"</text></outputEntry></rule><rule id="Decision_CourseReplacementEligibility_Rule_6"><description>Rule 4.27</description><inputEntry id="Decision_CourseReplacementEligibility_Rule_6_InEntry_1"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_6_InEntry_2"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_6_InEntry_3"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_6_InEntry_4"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_6_InEntry_5"><text>-</text></inputEntry><inputEntry id="Decision_CourseReplacementEligibility_Rule_6_InEntry_6"><text>-</text></inputEntry><outputEntry id="Decision_CourseReplacementEligibility_Rule_6_OutEntry_1"><text>true</text></outputEntry><outputEntry id="Decision_CourseReplacementEligibility_Rule_6_OutEntry_2"><text>"Eligible for course replacement, subject to Dean's approval"</text></outputEntry></rule></decisionTable></decision><dmndi:DMNDI><dmndi:DMNDiagram id="Definitions_CourseReplacement_Diagram"><dmndi:DMNShape id="Decision_CourseReplacementEligibility_Shape" dmnElementRef="Decision_CourseReplacementEligibility"><dc:Bounds x="60" y="60" width="220" height="90" /></dmndi:DMNShape></dmndi:DMNDiagram></dmndi:DMNDI></definitions>